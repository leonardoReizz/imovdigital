# ============================
# ImovDigital - Variáveis de Ambiente
# ============================

# Banco de Dados PostgreSQL
DATABASE_URL="postgresql://imovdigital:imovdigital123@localhost:5432/imovdigital?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT (Autenticação)
JWT_SECRET="trocar-por-uma-chave-secreta-segura"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="trocar-por-outra-chave-secreta-segura"
JWT_REFRESH_EXPIRES_IN="7d"

# Stripe (Pagamentos)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Cloudflare R2 (Armazenamento de imagens)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="imovdigital"
R2_PUBLIC_URL="https://cdn.imovdigital.com.br"

# Resend (E-mail)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@imovdigital.com.br"

# Aplicação
APP_URL="http://localhost:3000"
DASHBOARD_URL="http://localhost:5173"
WEB_URL="http://localhost:5174"
NODE_ENV="development"
PORT=3000

# Anthropic (Geração de SEO com IA)
ANTHROPIC_API_KEY=""

# Google Maps (Autocomplete de endereço no dashboard)
VITE_GOOGLE_MAPS_API_KEY=""

# Domínio base (para resolução de subdomínios)
BASE_DOMAIN="imovdigital.com.br"

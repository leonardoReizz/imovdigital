# ============================================
# Stage 1: Install dependencies
# ============================================
FROM node:20-alpine AS deps

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/dashboard/package.json apps/dashboard/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/utils/package.json packages/utils/package.json
COPY packages/config/package.json packages/config/package.json

RUN pnpm install --frozen-lockfile --prod=false

# ============================================
# Stage 2: Build
# ============================================
FROM deps AS build

COPY . .

RUN pnpm --filter @imovdigital/api exec prisma generate
RUN pnpm --filter @imovdigital/types build || true
RUN pnpm --filter @imovdigital/utils build || true
RUN pnpm --filter @imovdigital/dashboard build
RUN pnpm --filter @imovdigital/api build

# ============================================
# Stage 3: Production
# ============================================
FROM node:20-alpine

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# Copy everything needed to install prod deps
COPY --from=build /app/pnpm-lock.yaml /app/pnpm-workspace.yaml /app/package.json /app/turbo.json ./
COPY --from=build /app/apps/api/package.json apps/api/package.json
COPY --from=build /app/packages/types/package.json packages/types/package.json
COPY --from=build /app/packages/utils/package.json packages/utils/package.json
COPY --from=build /app/packages/config/package.json packages/config/package.json

# Install prod-only dependencies cleanly
RUN pnpm install --frozen-lockfile --prod

# API build output + prisma schema
COPY --from=build /app/apps/api/dist/ apps/api/dist/
COPY --from=build /app/apps/api/prisma/ apps/api/prisma/

# Generate Prisma client using project's prisma version
RUN ./node_modules/.bin/prisma generate --schema=apps/api/prisma/schema.prisma

# Shared packages (built)
COPY --from=build /app/packages/types/ packages/types/
COPY --from=build /app/packages/utils/ packages/utils/
COPY --from=build /app/packages/config/ packages/config/

# Dashboard — served by NestJS as static files
COPY --from=build /app/apps/dashboard/dist/ apps/api/public/dashboard/

ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "apps/api/dist/main.js"]

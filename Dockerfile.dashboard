# ============================================
# Dashboard — Vite SPA served by nginx
# ============================================
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

COPY . .

RUN pnpm install --frozen-lockfile

# Build shared packages
RUN pnpm --filter @imovdigital/types build || true
RUN pnpm --filter @imovdigital/utils build || true

# Build dashboard
RUN pnpm --filter @imovdigital/dashboard build

# ─── Serve with nginx ──────────────────────────
FROM nginx:alpine

COPY --from=builder /app/apps/dashboard/dist /usr/share/nginx/html
COPY nginx-dashboard.conf /etc/nginx/templates/default.conf.template

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

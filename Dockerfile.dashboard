# ============================================
# Dashboard — Vite SPA served by serve
# ============================================
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

COPY . .

RUN pnpm install --frozen-lockfile

# Build shared packages
RUN pnpm --filter @imovdigital/types build || true
RUN pnpm --filter @imovdigital/utils build || true

# Build dashboard
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN pnpm --filter @imovdigital/dashboard build

# ─── Serve ─────────────────────────────────────
FROM node:20-alpine

RUN npm install -g serve

COPY --from=builder /app/apps/dashboard/dist /app

EXPOSE 80

CMD ["serve", "-s", "/app", "-l", "80"]

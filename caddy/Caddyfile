{
	admin 0.0.0.0:2019
	http_port 80
	https_port 443

	on_demand_tls {
		interval 1m
		burst 10
	}
}

:443 {
	tls {
		on_demand
	}

	reverse_proxy srv-captain--imovdigital-cliente:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

:80 {
	reverse_proxy srv-captain--imovdigital-cliente:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
